@PACKAGE_INIT@

# SDK 自带的运行库必须与静态库配置一致；不依赖消费方 lumen_DIR 的写法。
if(@LUMEN_HAS_BUNDLED_LUMATEXT@)
    if(NOT TARGET lumen::LumaText)
        add_library(lumen::LumaText SHARED IMPORTED)
        foreach(_config IN ITEMS RELEASE DEBUG RELWITHDEBINFO MINSIZEREL)
            if(_config STREQUAL "DEBUG")
                set(_suffix d)
            else()
                set(_suffix "")
            endif()
            set(_implib "@PACKAGE_CMAKE_INSTALL_LIBDIR@/lumatext${_suffix}.lib")
            set(_dll "@PACKAGE_CMAKE_INSTALL_BINDIR@/lumatext${_suffix}.dll")
            if(EXISTS "${_implib}" AND EXISTS "${_dll}")
                set_property(TARGET lumen::LumaText APPEND PROPERTY IMPORTED_CONFIGURATIONS ${_config})
                set_target_properties(lumen::LumaText PROPERTIES
                    IMPORTED_IMPLIB_${_config} "${_implib}"
                    IMPORTED_LOCATION_${_config} "${_dll}")
            endif()
        endforeach()
    endif()
    if(NOT TARGET LumaText::D2D)
        add_library(LumaText::D2D INTERFACE IMPORTED)
        set_property(TARGET LumaText::D2D PROPERTY INTERFACE_LINK_LIBRARIES lumen::LumaText)
    endif()
elseif(@LUMEN_HAS_EXTERNAL_LUMATEXT@)
    include(CMakeFindDependencyMacro)
    find_dependency(LumaText 0.1 CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/lumenTargets.cmake")
if(@LUMEN_HAS_BUNDLED_LUMATEXT@)
    set_property(TARGET lumen::lumen PROPERTY LUMEN_LUMATEXT_RUNTIME lumen::LumaText)
elseif(TARGET LumaText::Shared)
    set_property(TARGET lumen::lumen PROPERTY LUMEN_LUMATEXT_RUNTIME LumaText::Shared)
endif()
if(EXISTS "${PACKAGE_PREFIX_DIR}/licenses/LumaText")
    set_property(TARGET lumen::lumen PROPERTY LUMEN_RUNTIME_LICENSES "${PACKAGE_PREFIX_DIR}/licenses/LumaText")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/lumenRuntime.cmake")
check_required_components(lumen)